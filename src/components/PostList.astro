---
import FormattedDate from './FormattedDate.astro';
import { CATEGORIES } from '../consts';
import type { Post } from '../lib/posts';

interface Props {
	posts: Post[];
	/** Show the category chip on each row. Off on single-category pages. */
	showCategory?: boolean;
	empty?: string;
}

const { posts, showCategory = false, empty = 'Nothing here yet.' } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="muted">{empty}</p>
	) : (
		<ul class="posts">
			{posts.map((post) => (
				<li>
					<a class="row" href={`/blog/${post.id}/`}>
						<span class="title">
							{post.data.title}
							{post.data.draft && <span class="draft">draft</span>}
						</span>
						<span class="meta">
							{showCategory && <span class="cat">{CATEGORIES[post.data.category].label}</span>}
							<FormattedDate date={post.data.pubDate} />
						</span>
					</a>
					<p class="desc">{post.data.description}</p>
				</li>
			))}
		</ul>
	)
}

<style>
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.posts li {
		padding: 1.1em 0;
		border-bottom: 1px solid var(--rule);
	}
	.row {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		text-decoration: none;
		color: var(--ink);
	}
	.row:hover .title {
		color: var(--accent);
	}
	.title {
		font-weight: 600;
	}
	.draft {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border: 1px solid currentColor;
		border-radius: 2px;
		padding: 1px 5px;
		margin-left: 0.6em;
		color: var(--ink-dim);
		vertical-align: middle;
	}
	.meta {
		flex: none;
		font-size: 0.8rem;
		color: var(--ink-dim);
		white-space: nowrap;
	}
	.cat {
		margin-right: 0.7em;
	}
	.desc {
		margin: 0.35em 0 0;
		color: var(--ink-dim);
		font-size: 0.92rem;
	}
	@media (max-width: 560px) {
		.row {
			flex-direction: column;
			gap: 0.2em;
		}
	}
</style>
