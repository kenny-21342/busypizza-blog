---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectPanel from '../components/ProjectPanel.astro';
import { CATEGORIES } from '../consts';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags, draft, project } =
	Astro.props;
const categoryMeta = CATEGORIES[category];
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article>
				<header class="post-head">
					<p class="meta">
						<a class="cat" href={`/${category}`}>{categoryMeta.label}</a>
						<span class="sep">·</span>
						<FormattedDate date={pubDate} />
						{draft && <span class="draft">draft</span>}
					</p>
					<h1>{title}</h1>
					<p class="desc">{description}</p>
					{
						updatedDate && (
							<p class="updated">
								Updated <FormattedDate date={updatedDate} />
							</p>
						)
					}
				</header>
				{
					heroImage && (
						<figure class="hero">
							<Image width={1020} height={510} src={heroImage} alt="" />
						</figure>
					)
				}
				<div class="prose">
					<slot />
				</div>
				{project && <ProjectPanel slug={project} />}
				{
					tags.length > 0 && (
						<footer class="tags">
							{tags.map((tag) => (
								<a href={`/tags/${tag}/`}>{tag}</a>
							))}
						</footer>
					)
				}
			</article>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-head {
		margin-bottom: 2em;
	}
	.meta {
		font-size: 0.8rem;
		color: var(--ink-dim);
		margin: 0 0 0.6em;
		display: flex;
		align-items: center;
		gap: 0.5em;
	}
	.cat {
		text-decoration: none;
		color: var(--accent);
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-size: 0.7rem;
	}
	.sep {
		opacity: 0.5;
	}
	.draft {
		font-size: 0.65rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		border: 1px solid currentColor;
		border-radius: 2px;
		padding: 1px 5px;
	}
	.desc {
		color: var(--ink-dim);
		margin: 0.4em 0 0;
		max-width: 56ch;
	}
	.updated {
		font-size: 0.8rem;
		color: var(--ink-dim);
		font-style: italic;
		margin: 0.6em 0 0;
	}
	.hero {
		margin: 0 0 2em;
	}
	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid var(--rule);
	}
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5em;
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid var(--rule);
	}
	.tags a {
		font-size: 0.8rem;
		border: 1px solid var(--rule);
		border-radius: 2px;
		padding: 2px 8px;
		text-decoration: none;
		color: var(--ink-dim);
	}
	.tags a:hover {
		border-color: var(--accent);
		color: var(--accent);
	}
</style>
